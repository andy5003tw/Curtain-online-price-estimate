        var inputPath = pickInputFile("選取 GSC 生成式 AI 功能 Excel", "Excel Workbook (*.xlsx)|*.xlsx");
        if (!inputPath) { setStatusSummary("已取消選取 GSC 生成式 AI Excel。", ""); return; }
