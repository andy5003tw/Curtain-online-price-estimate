        if (!inputPath || !fso.FileExists(inputPath)) { setStatusSummary("找不到 AI Visibility observation JSON：\n" + inputPath, "error"); return; }
        var logPath = root + "\\latest\\ai-visibility-last-run.log";
        var cmd = 'cmd /d /c pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "' + writer.replace(/"/g, '""') + '" -RuntimeRoot "' + root.replace(/"/g, '""') + '" -InputPath "' + inputPath.replace(/"/g, '""') + '" -QuestionSetPath "' + questionSet.replace(/"/g, '""') + '" > "' + logPath.replace(/"/g, '""') + '" 2>&1';
        setButtonsBusy(true);
