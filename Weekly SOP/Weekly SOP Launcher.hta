        if (!fso.FileExists(inputPath)) { throw new Error("找不到 Excel 檔案：\n" + inputPath); }
        var logPath = root + "\\latest\\gsc-generative-ai-last-run.log";
        var cmd = 'cmd /d /c pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "' + analyzer.replace(/"/g, '""') + '" -InputPath "' + inputPath.replace(/"/g, '""') + '" -RuntimeRoot "' + root.replace(/"/g, '""') + '" > "' + logPath.replace(/"/g, '""') + '" 2>&1';
        setButtonsBusy(true);
        setStatusSummary("正在分析 GSC「生成式 AI 功能」Excel；只會產生曝光摘要，不會更新 AI Visibility 指標...", "running");
        var code = new ActiveXObject("WScript.Shell").Run(cmd, 1, true);
        var logText = readTextIfExists(logPath);
        setStatusDetails("Command:\n" + cmd + "\n\nInput:\n" + inputPath + "\n\nLog:\n" + logText);
        setStatusSummary(code === 0 ? "GSC 生成式 AI Excel 分析完成。\n\n摘要：\n" + root + "\\latest\\gsc-generative-ai-analysis.md\n\n此資料僅描述 GSC 生成式 AI 曝光，不會推論 AI Visibility 的提及／引用率。" : "GSC 生成式 AI Excel 分析失敗。\n\n" + logText, code === 0 ? "success" : "error");
      } catch (e) {
