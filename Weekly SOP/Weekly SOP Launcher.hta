    function advanceSeoGeoRound() {
      try {
        var root = getRootFolder();
        var snapshot = getQueueSnapshot(root);
        if (!snapshot.exists || snapshot.isStale || snapshot.isObservation) {
          setStatusSummary("Round 前進條件不成立：需要 current executable queue。", "error");
          return;
        }
        var state = snapshot.state;
        var activeRound = Number(state.active_round || state.next_round || 1);
        var totalRounds = Number(state.total_rounds || 0);
        if (state.status !== "active" || activeRound < 1 || activeRound > totalRounds) {
          setStatusSummary("本次 queue 不是可前進的 active Round；目前狀態：" + state.status, "error");
          return;
        }
        if (!confirm("Round " + activeRound + "/" + totalRounds + " 的 validation receipt 將由 PowerShell writer 重驗並交易式前進。確認繼續嗎？")) { return; }
        invokeSeoGeoWorkflowWriter(root, "round_validated", "", "Round " + activeRound + " validated");
      } catch (e) {
        setStatusSummary("Round transaction 失敗：" + e.message, "error");
      } finally {
        setButtonsBusy(false);
        refreshQueueStatus();
        updateWorkflowControls();
      }
    }

    function copyOptionalSeoGeoPrompt() {
      try {
        var root = getRootFolder();
        var target = root + "\\latest\\seo-geo-action-plan.optional.slim.ai.md";
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var queue = readJsonIfExists(root + "\\latest\\seo-geo-action-queue.json");
        var optionalItems = queue && queue.optional_opportunities ? asArray(queue.optional_opportunities) : [];
        var optionalCount = optionalItems.length;
        var hasSinglePageReview = optionalItems.some(function (item) { return item && (item.review_type === "single_page_p0_review" || item.review_type === "single_page_alignment_review"); });
        if (optionalCount === 0) {
          setStatusSummary("Optional Opportunities 為 0，目前沒有小幅優化參考項目可複製。", "success");
          updateWorkflowControls();
          return;
        }
        if (!fso.FileExists(target)) {
          setStatusSummary("找不到小幅可優化參考指令。\n請先點「產生 SEO/GEO 優化建議」。", "error");
          return;
        }
        var text = readTextIfExists(target);
        if (!text) {
          setStatusSummary("小幅可優化參考指令是空的，請重新產生 SEO/GEO 優化建議。", "error");
          return;
        }
        if (window.clipboardData && window.clipboardData.setData) {
          window.clipboardData.setData("Text", text);
          setStatusSummary("已複製" + (hasSinglePageReview ? "單頁 P0 review" : "小幅可優化參考") + "指令：\n" + target + "\n\n貼給 AI 後，只會審查；需使用者明確批准才可修改 source。", "success");
        } else {
          setStatusSummary("目前 HTA 環境不支援剪貼簿，請直接開啟小幅可優化參考指令：\n" + target, "error");
        }
      } catch (e) {
        setStatusSummary("複製小幅可優化參考指令失敗：" + e.message, "error");
      }
    }

    function approveSinglePageReview() {
      try {
        var root = getRootFolder();
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var snapshot = getQueueSnapshot(root);
        var items = snapshot.queue && snapshot.queue.optional_opportunities ? asArray(snapshot.queue.optional_opportunities) : [];
        var reviews = items.filter(function (item) { return item && (item.review_type === "single_page_p0_review" || item.review_type === "single_page_alignment_review") && item.requires_user_approval === true; });
        if (!snapshot.exists || snapshot.isStale || !snapshot.isObservation || reviews.length < 1 || reviews.length > 6) {
          setStatusSummary("單頁核准條件不成立：需要 current observation_only queue 與 1～6 個 approval-only single-page reviews。", "error");
          updateWorkflowControls();
          return;
        }
        var pages = [];
        for (var i = 0; i < reviews.length; i++) { pages.push(String(reviews[i].page || "")); }
        if (!confirm("確認核准以下 " + pages.length + " 個單頁 reviews，並各自建立連續 executable Round？\n\n" + pages.join("\n") + "\n\n每個 Round 都必須完成自己的 validation receipt 才能前進。")) { return; }
        var approvedBy = prompt("核准者（必填）：", "site owner");
        if (approvedBy === null) { return; }
        var reason = prompt("核准理由（必填）：", "核准以上單頁候選依序進入各自的實作 Round。");
        if (reason === null) { return; }
        approvedBy = String(approvedBy).replace(/^\s+|\s+$/g, "");
        reason = String(reason).replace(/^\s+|\s+$/g, "");
        if (!approvedBy || !reason || /[\"%]/.test(approvedBy) || /[\"%]/.test(reason)) {
          setStatusSummary("核准者與理由不可空白，也不可包含雙引號或 %。", "error");
          return;
        }
        var args = ' -Page "' + pages.join("|").replace(/"/g, '""') + '" -ApprovedBy "' + approvedBy + '" -Reason "' + reason + '"';
        invokeSeoGeoWorkflowWriter(root, "strategy_approved", args, "單頁 strategy approval / " + pages.length + " sequential Rounds");
      } catch (e) {
        setStatusSummary("單頁 review 核准失敗：" + e.message, "error");
      } finally {
        setButtonsBusy(false);
        refreshQueueStatus();
        updateWorkflowControls();
      }
    }

    function invokeLifecycleNext() {
      try {
        var root = getRootFolder();
        var inspection = getLifecycleNextInspection(root);
        if (!inspection || !inspection.ready) {
          setStatusSummary("目前 lifecycle 不可前進：\n" + ((inspection && inspection.reason) || "必要 evidence 尚未完成"), "error");
          return;
        }
        var decision = "";
        var summary = "";
        if (inspection.needs_input) {
          decision = prompt("請輸入 28 天策略決策：\nkeep＝維持、refine＝微調、expand＝擴大、replace＝更換", "keep");
          if (decision === null) { return; }
          decision = String(decision).replace(/^\s+|\s+$/g, "").toLowerCase();
          if (["keep", "refine", "expand", "replace"].indexOf(decision) < 0) {
            setStatusSummary("28 天策略決策無效；只接受 keep、refine、expand 或 replace。", "error");
            return;
          }
          summary = prompt("請輸入 28 天檢討摘要（必填，系統不會自行猜測）：", "");
          if (summary === null) { return; }
          summary = String(summary).replace(/^\s+|\s+$/g, "");
          if (!summary || /[\"%\r\n]/.test(summary)) {
            setStatusSummary("28 天摘要不可空白，也不可包含雙引號、%、換行。", "error");
            return;
          }
        }
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var script = fso.GetParentFolderName(root) + "\\scripts\\invoke-seo-geo-lifecycle-next.ps1";
        if (!fso.FileExists(script)) { throw new Error("找不到 lifecycle 智慧控制器：\n" + script); }
        var cmd = 'pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "' + script.replace(/"/g, '""') + '" -RuntimeRoot "' + root.replace(/"/g, '""') + '" -Mode Advance';
        if (decision) { cmd += ' -Decision "' + decision + '" -Summary "' + summary + '"'; }
        setButtonsBusy(true);
        setStatusSummary("正在驗證可信 evidence 並前進一個 lifecycle 階段...", "running");
        var exec = new ActiveXObject("WScript.Shell").Exec(cmd);
        var output = exec.StdOut.ReadAll();
        var error = exec.StdErr.ReadAll();
        setStatusDetails("Command:\n" + cmd + "\n\nOutput:\n" + output + "\n\nError:\n" + error);
        setStatusSummary(exec.ExitCode === 0 ? ("已完成一個階段：" + inspection.label + "。\n\n系統已重新判斷下一步。") : ("Lifecycle 未前進；transaction 已 rollback 或保留 recovery journal。\n\n" + (error || output)), exec.ExitCode === 0 ? "success" : "error");
      } catch (e) {
        setStatusSummary("Lifecycle 智慧操作失敗：" + e.message, "error");
      } finally {
        setButtonsBusy(false);
        refreshQueueStatus();
        updateWorkflowControls();
      }
    }

    function executeCurrentSeoGeoNextStep() {
      if (!currentSeoGeoNextAction || !currentSeoGeoNextAction.enabled) {
        setStatusSummary("目前沒有可執行的下一步。\n\n" + ((currentSeoGeoNextAction && currentSeoGeoNextAction.reason) || "請查看流程提示。"), "warn");
        return;
      }
      switch (currentSeoGeoNextAction.type) {
        case "copy_round": copyLatestSeoGeoAiPrompt(); break;
        case "advance_round": advanceSeoGeoRound(); break;
        case "approve_single_page": approveSinglePageReview(); break;
        case "dry_run": runSeoGeoDeployment(true); break;
        case "deploy": runSeoGeoDeployment(false); break;
        case "live_verify": runSeoGeoLiveVerification(); break;
        case "lifecycle": invokeLifecycleNext(); break;
        default: setStatusSummary("目前下一步類型無法辨識，請重新整理 UI。", "error");
      }
    }

    function toggleAdvancedSeoGeoActions() {
      var panel = document.getElementById("advancedSeoGeoActions");
      var link = document.getElementById("toggleAdvancedSeoGeoActions");
      if (!panel || !link) { return false; }
      var show = panel.style.display !== "block";
      panel.style.display = show ? "block" : "none";
      link.innerText = show ? "收合進階／故障排除操作" : "顯示進階／故障排除操作";
      return false;
    }

    function toggleMonthlyAiAction() {
      var panel = document.getElementById("monthlyAiAction");
      var link = document.getElementById("toggleMonthlyAiAction");
      if (!panel || !link) { return false; }
      var show = panel.style.display !== "block";
      panel.style.display = show ? "block" : "none";
      link.innerText = show ? "收合每月 AI 可見度／生成式 AI 檢查" : "顯示每月 AI 可見度／生成式 AI 檢查（選用）";
      return false;
    }

    function recordLifecycleStage(stage) {
      try {
        var root = getRootFolder();
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var stageHint = "";
        if (stage === "observing_7d") {
          stageHint = "\n\n操作提醒：先成功匯入最新 7d／28d。只有 7d manifest 為 decision_ready，且 end_date 已涵蓋部署後完整 7 日，才可使用綁定目前 queue 與 7d manifest SHA 的 evidence JSON。";
        } else if (stage === "reviewed_28d") {
          stageHint = "\n\n操作提醒：先成功匯入最新 7d／28d。只有 28d manifest 為 decision_ready，且 end_date 已涵蓋部署後完整 28 日；evidence 必須含 keep／refine／expand／replace 決策與摘要。";
        }
        var evidencePath = prompt("請輸入 " + stage + " evidence JSON 的完整檔案路徑。\n每一階段都必須含 queue_id、cycle_key、queue_sha256、完整 action_ids；implemented/local_validated/deployed 另需 validation_receipt_sha256。writer 會驗證必要欄位與 GSC manifest SHA。" + stageHint, "");
        if (evidencePath === null) { return; }
        evidencePath = String(evidencePath).replace(/^\s+|\s+$/g, "");
        if (!evidencePath || !fso.FileExists(evidencePath)) {
          setStatusSummary("找不到 lifecycle evidence JSON：\n" + evidencePath, "error");
          return;
        }
        var safeEvidence = evidencePath.replace(/"/g, '""');
        invokeSeoGeoWorkflowWriter(root, stage, '-EvidencePath "' + safeEvidence + '"', "lifecycle " + stage);
      } catch (e) {
        setStatusSummary("Lifecycle stage 操作失敗：" + e.message, "error");
      } finally {
        setButtonsBusy(false);
        refreshQueueStatus();
        updateWorkflowControls();
      }
    }

    function init() {
      function bindClick(id, handler) {
        var element = document.getElementById(id);
        if (element) { element.onclick = handler; }
      }
      bindClick("btnFetchGscLatest", fetchLatestGscReports);
      bindClick("btnSeoGeoNextSmart", executeCurrentSeoGeoNextStep);
      bindClick("btnOpenSeoGeoActionPlan", openLatestSeoGeoActionPlan);
      bindClick("btnImportAiVisibility", runAiVisibilityAutomation);
      bindClick("btnRunAiVisibilityLunaComparison", runAiVisibilityLunaComparison);
      bindClick("btnAnalyzeGscGenerativeAi", analyzeGscGenerativeAiExcel);
      bindClick("btnToggleQueueDetails", toggleQueueDetails);
      bindClick("toggleMonthlyAiAction", toggleMonthlyAiAction);
      bindClick("btnToggleDetails", toggleDetails);
      var fontButtons = document.getElementsByTagName("button");
      for (var i = 0; i < fontButtons.length; i++) {
        if (fontButtons[i].getAttribute("data-font-scale")) {
          fontButtons[i].onclick = setFontScaleFromControl;
        }
      }
      applyFontScale(readSavedFontScale(), false);
      resetQueueDetailsCollapsed();
      resetDetailsCollapsed();
      refreshHealth();
    }
  </script>
</head>
<body onload="init()">
  <div class="card">
    <div class="heading">
      <h1>Weekly SOP 一鍵執行</h1>
      <div class="heading-tools">
        <div class="font-controls" title="調整介面字體大小；設定會記住">
          <span class="font-control-label">字體 <span id="fontScaleValue">110%</span></span>
          <button type="button" class="btn-font-scale" data-font-scale="0.9">90%</button>
          <button type="button" class="btn-font-scale" data-font-scale="1">100%</button>
          <button type="button" class="btn-font-scale" data-font-scale="1.1">110%</button>
          <button type="button" class="btn-font-scale" data-font-scale="1.25">125%</button>
          <button type="button" class="btn-font-scale" data-font-scale="1.4">140%</button>
        </div>
        <span class="tag">GSC API／一鍵更新 7 天與 28 天</span>
      </div>
    </div>

    <p class="intro">日常只要看流程提示，按下目前可用的按鈕。系統會自動以 Search Console 的 final 資料更新報表、建立行動報告，並在每一步做安全檢查。</p>

    <div class="flow-panel" id="workflowStatusPanel">
      <div class="flow-title" id="workflowStatusTitle">流程狀態：檢查中</div>
      <div class="flow-next" id="workflowStatusNext">正在讀取最新 7 天／28 天資料、目標關鍵字對應表、工作佇列狀態與驗收紀錄。</div>
    </div>

    <div class="report-actions">
      <button id="btnFetchGscLatest" class="btn-fetch-gsc">更新最新 GSC 資料</button>
    </div>
    <p class="report-actions-note">系統只接受 Google 搜尋主控台已完成結算的完整日期；更新完成後會自動重建 SEO/GEO 行動報告。</p>

    <div class="section-title">目前 SEO/GEO（搜尋與生成式引擎優化）步驟</div>
    <div class="seo-geo-actions">
      <button id="btnSeoGeoNextSmart" class="btn-seo-geo">執行目前下一步</button>
      <button id="btnOpenSeoGeoActionPlan" class="btn-upload-fallback">查看目前 SEO/GEO 優化報表</button>
    </div>
    <p class="seo-geo-note">這個按鈕會依目前狀態自動切換為：複製 AI 指令、驗證並前進、部署預演、正式上傳、上線驗證，或記錄必要 lifecycle receipt。正式上傳與 28 天策略決策仍會要求你確認。</p>
    <button id="toggleMonthlyAiAction" type="button" class="btn-monthly-ai-toggle">顯示每月 AI 可見度／生成式 AI 檢查（選用）</button>
    <div id="monthlyAiAction" class="advanced-seo-geo-actions">
      <button id="btnImportAiVisibility" class="btn-seo-geo btn-ai-visibility">執行 AI 可見度檢查</button>
      <button id="btnRunAiVisibilityLunaComparison" class="btn-seo-geo btn-ai-luna">Luna 對照測試（額外模型費用）</button>
      <button id="btnAnalyzeGscGenerativeAi" class="btn-seo-geo btn-gsc-generative-ai">分析 GSC 生成式 AI Excel 報表</button>
      <p class="seo-geo-note">一般檢查會用預設模型完成並匯入固定 6 題。Luna 對照會以 <strong>gpt-5.6-luna</strong> 另跑同一組題目，產生獨立比較報告，不會覆蓋目前正式結果；因會多呼叫一個模型，將增加該模型的 API 用量／費用。兩者皆需要設定 <strong>OPENAI_API_KEY</strong>。</p>
      <p class="seo-geo-note">「分析 GSC 生成式 AI Excel」請選取 GSC 下載的 <strong>.xlsx</strong>。它只分析 GSC 生成式 AI 功能曝光，不會改寫 direct AI Visibility 的提及、引用或正確性指標。</p>
    </div>

    <div class="section-title">六區每週作業總覽</div>
    <div class="six-zone-grid" id="sixZoneDashboard">
      <div class="six-zone" id="zoneDataTrust">讀取中...</div>
      <div class="six-zone" id="zoneOwnerPortfolio">讀取中...</div>
      <div class="six-zone" id="zoneDecision">讀取中...</div>
      <div class="six-zone" id="zoneStrategy">讀取中...</div>
      <div class="six-zone" id="zoneImplementation">讀取中...</div>
      <div class="six-zone" id="zonePerformance">讀取中...</div>
    </div>

    <div class="queue-panel" id="queueStatusPanel">
      <div class="queue-head">
        <div class="queue-head-left">
          <span>目前工作佇列狀態（Queue）</span>
          <button id="btnToggleQueueDetails" type="button" class="btn-queue-detail">展開工作佇列明細</button>
        </div>
        <span id="queueStatusBadge">檢查中...</span>
      </div>
      <div class="queue-body" id="queueStatusSummary">檢查中...</div>
      <div class="queue-details" id="queueDetails"><div class="queue-body" id="queueStatusBody">檢查中...</div></div>
    </div>

    <div class="status-wrap" id="statusWrap">
      <div class="status-head">執行狀態</div>
      <div id="statusSummary">待命中。</div>
      <div class="detail-actions">
        <button id="btnToggleDetails" class="btn-detail">展開明細</button>
      </div>
      <div id="statusDetails">
        <div class="details-section-title">環境與資料狀態</div>
        <div class="health-grid">
          <div class="health-item" id="healthPwsh">
            <div class="health-label">PowerShell</div>
            <div class="health-value" id="healthPwshValue">檢查中...</div>
          </div>
          <div class="health-item" id="healthNode">
            <div class="health-label">Node</div>
            <div class="health-value" id="healthNodeValue">檢查中...</div>
          </div>
          <div class="health-item" id="healthNpm">
            <div class="health-label">npm.cmd</div>
            <div class="health-value" id="healthNpmValue">檢查中...</div>
          </div>
          <div class="health-item" id="health7d">
            <div class="health-label">最新 7 天資料</div>
            <div class="health-value" id="health7dValue">檢查中...</div>
          </div>
          <div class="health-item" id="health28d">
            <div class="health-label">最新 28 天資料</div>
            <div class="health-value" id="health28dValue">檢查中...</div>
          </div>
          <div class="health-item" id="healthPool">
            <div class="health-label">目標關鍵字對應表</div>
            <div class="health-value" id="healthPoolValue">檢查中...</div>
          </div>
          <div class="health-item" id="healthPlan">
            <div class="health-label">優化行動報告</div>
            <div class="health-value" id="healthPlanValue">檢查中...</div>
          </div>
        </div>
        <div class="details-section-title">執行明細</div>
        <div id="statusDetailsLog">目前沒有執行明細。</div>
      </div>
    </div>

    <div class="footer">Weekly SOP 啟動器｜介面版本 2026-07-15｜需要 PowerShell 7</div>
  </div>
</body>
</html>
